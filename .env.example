# Postgres connection string (Neon: dùng connection string dạng "pooled").
# Bỏ trống khi chạy local: app sẽ dùng PGlite lưu ở ./.data/pglite
DATABASE_URL=

# Chuỗi bí mật để ký cookie đăng nhập, BẮT BUỘC khi deploy. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
